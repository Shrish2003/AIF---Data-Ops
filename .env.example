# ==========================================================
# Adaptive Intelligence Fabric (AIF)
# Environment Variables
#
# Copy this file to .env and fill in real values. Never commit
# the real .env file. Every value below is read only from the
# environment or configurations.
# ==========================================================

# ----------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------
# Logging level for workflow executions. Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
AIF_LOG_LEVEL=WARNING

# ----------------------------------------------------------
# Ollama (local — no API key required)
# ----------------------------------------------------------
# The base URL where the local Ollama daemon is running
OLLAMA_BASE_URL=http://localhost:11434
# Model name to be loaded by Ollama for both recommendations and RAGAS evaluations
OLLAMA_MODEL=llama3.2:3b
# Creativity temperature of the model (higher means more creative, lower means more deterministic)
OLLAMA_TEMPERATURE=0.2
# Timeout in seconds for model invocation requests (note: client uses a minimum floor of 90s)
OLLAMA_TIMEOUT_SECONDS=30
# Maximum retry attempts if an API call fails
OLLAMA_MAX_RETRIES=1

# ----------------------------------------------------------
# Grok (xAI)
# ----------------------------------------------------------
# API Key for xAI's Grok service (if used for cloud escalation fallback)
GROK_API_KEY=
# Grok API base endpoint URL
GROK_BASE_URL=https://api.x.ai/v1/chat/completions
# Grok model name to be utilized
GROK_MODEL=grok-4-latest
# Creativity temperature of the Grok model
GROK_TEMPERATURE=0.2
# Token limit returned by xAI's Grok API
GROK_MAX_OUTPUT_TOKENS=512
# Timeout in seconds for model invocation requests
GROK_TIMEOUT_SECONDS=20
# Maximum retry attempts if an API call fails
GROK_MAX_RETRIES=2

# ----------------------------------------------------------
# Selection Order
#
# Comma-separated, tried left to right. If every provider in
# this list fails or is unset, the Recommendation Agent's
# deterministic rule-based recommendation is used instead.
# Note: The active client execution router currently hardcodes
# selection to Ollama.
# ----------------------------------------------------------
LLM_SELECTION_ORDER=grok,ollama

# ----------------------------------------------------------
# Operational Memory Configuration
# ----------------------------------------------------------
# The model name to be loaded by Ollama for generating embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# The persistent directory where local ChromaDB data is stored
CHROMADB_PERSIST_DIR=data/chromadb

# Feature toggle for the persistent semantic Operational Memory layer
OPERATIONAL_MEMORY_ENABLED=false
# Number of similar historical incident memories to retrieve
OPERATIONAL_MEMORY_TOP_K=3
#Authoritative distance threshold (lower is closer match, e.g. 0.50)
OPERATIONAL_MEMORY_DISTANCE_THRESHOLD=0.50

# ----------------------------------------------------------
# Phase 3.1 — Operational Memory Performance Optimization
# ----------------------------------------------------------
# Enable/disable the bounded in-process LRU embedding cache.
# When enabled, identical retrieval queries reuse their embedding vector,
# eliminating redundant Ollama HTTP calls on repeated or warm queries.
# Only active when OPERATIONAL_MEMORY_ENABLED=true.
OPERATIONAL_MEMORY_EMBED_CACHE_ENABLED=true

# Maximum number of query→vector entries held in the in-process LRU cache.
# Once the limit is exceeded, the least-recently-used entry is evicted.
# The cache is never written to disk and never shared across processes.
OPERATIONAL_MEMORY_EMBED_CACHE_SIZE=128

# Enable/disable optional Ollama model warm-up during MemoryService initialization.
# When enabled, sends a single dummy embedding request at startup to pre-load
# the model and reduce first-call latency. Set to false for normal operation.
# Warm-up failures are non-fatal and do not prevent AIF startup.
OLLAMA_EMBEDDING_WARMUP_ENABLED=false
